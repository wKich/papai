{
  "name": "afk-runner",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "cd .. && bun test tests/afk-runner",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "cd .. && oxlint --config .oxlintrc.json afk-runner/src tests/afk-runner",
    "format": "cd .. && oxfmt --write afk-runner/src tests/afk-runner --ignore-path=.oxfmtignore",
    "format:check": "cd .. && oxfmt --check afk-runner/src tests/afk-runner --ignore-path=.oxfmtignore",
    "start": "bun run src/cli.ts"
  },
  "dependencies": {
    "p-limit": "^7.3.2",
    "xstate": "5.32.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
